# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/expense_tracker
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- JWT ---
# Must be a long, random string (32+ bytes). Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173

# --- Frontend env (used by React/Vite build) ---
VITE_API_BASE_URL=http://localhost:8080/api
